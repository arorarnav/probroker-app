# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to GitHub — it holds real secrets.

# From Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Also from Supabase: Project Settings -> API -> "service_role" key.
# KEEP THIS SECRET -- never put it in a page that runs in the browser.
# It's only ever read inside app/api/verify-payment/route.js on the server.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# From Razorpay: Dashboard -> Settings -> API Keys (use TEST keys until you're ready to charge real money)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret

# This one is safe to expose to the browser (it's public by design)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
